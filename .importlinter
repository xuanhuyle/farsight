; ADR-013 -- package boundaries, in CI from the first commit.
; Boundary erosion is the modular monolith's characteristic death mode, so these run before
; there is enough code for anyone to erode.

[importlinter]
root_package = farsight
include_external_packages = True

[importlinter:contract:schemas_is_leaf]
name = schemas imports nothing internal
type = forbidden
source_modules =
    farsight.schemas
forbidden_modules =
    farsight.hashing
    farsight.units
    farsight.registry
    farsight.engines
    farsight.faults
    farsight.uncertainty
    farsight.experiments
    farsight.metrics
    farsight.comparison
    farsight.evidence
    farsight.cli
    farsight.analysis

[importlinter:contract:auditor_boundary]
; THE commercially decisive rule: `farsight evidence verify` must run on a clean install with
; zero engine extras, on an auditor's laptop. evidence/ and hashing/ therefore never import
; engines/ -- not the adapters, not the worker, not the base protocols.
name = evidence and hashing never import engines
type = forbidden
source_modules =
    farsight.evidence
    farsight.hashing
forbidden_modules =
    farsight.engines

[importlinter:contract:adapters_only_via_base]
; The planner and the fault/uncertainty compilers see adapters only through the protocols.
name = orchestration sees adapters only via engines.base
type = forbidden
source_modules =
    farsight.faults
    farsight.uncertainty
    farsight.experiments
forbidden_modules =
    farsight.engines.spice
    farsight.engines.basilisk
    farsight.engines.linkchain
    farsight.engines.gmat

[importlinter:contract:analysis_quarantine]
; analysis/ is the only package allowed heavy interactive dependencies. Nothing in the truth
; loop may import it.
name = nothing in the truth loop imports analysis
type = forbidden
source_modules =
    farsight.schemas
    farsight.hashing
    farsight.units
    farsight.registry
    farsight.engines
    farsight.faults
    farsight.uncertainty
    farsight.experiments
    farsight.metrics
    farsight.comparison
    farsight.evidence
forbidden_modules =
    farsight.analysis

[importlinter:contract:no_llm_sdk]
; ADR-025. "Is an LLM installed?" must be answerable `no` from a lock file, with no qualifier.
name = no LLM SDK anywhere in the repository
type = forbidden
source_modules =
    farsight
forbidden_modules =
    anthropic
    openai
    langchain
    llama_index
    transformers

[importlinter:contract:no_units_lib_in_core]
; ADR-008: units are validated at schema boundaries and normalized once; the numeric core is
; raw SI float64. A unit library in an inner loop is a 20-100x tax and a correctness illusion.
name = no unit library in the numeric core
type = forbidden
; ADR-008 Enforcement 2 names the source set exactly: farsight.engines, farsight.metrics,
; farsight.uncertainty and farsight.hashing, permitted in farsight.schemas, farsight.units and
; farsight.analysis only. The contract shipped naming just `metrics` and `engines.linkchain`,
; which left `engines.spice` unguarded -- and that is the module where ADR-015 decision 7's
; whole point lives: the SPICE time path and the astropy time path are cross-checked, never
; collapsed into one call. Without this the independence claim could become false at the bit
; level with every test still green.
source_modules =
    farsight.engines
    farsight.metrics
    farsight.uncertainty
    farsight.hashing
forbidden_modules =
    astropy
    pint

[importlinter:contract:no_network_in_truth_loop]
; ADR-012 Enforcement 2 names the forbidden set and the single exception exactly: `socket`,
; `http`, `urllib`, `ftplib`, `smtplib`, `requests` and `httpx` are forbidden in every `farsight`
; package except `farsight.acquire`, which is itself importable only from the CLI's fetch module.
;
; The contract shipped naming only the four third-party clients, and listing six of the twelve
; packages as sources -- so `urllib` was importable anywhere and `farsight.registry`,
; `farsight.units`, `farsight.cli`, `farsight.faults`, `farsight.uncertainty` and
; `farsight.comparison` were unguarded entirely. The stdlib omission was the sharp one: the
; obvious way to write a downloader uses `urllib`, so the contract forbade the imports nobody
; was going to reach for and permitted the one they would.
name = no network in the truth loop
type = forbidden
source_modules =
    farsight.schemas
    farsight.hashing
    farsight.experiments
    farsight.engines
    farsight.metrics
    farsight.evidence
    farsight.registry
    farsight.units
    farsight.cli
    farsight.faults
    farsight.uncertainty
    farsight.comparison
    farsight.analysis
forbidden_modules =
    socket
    http
    urllib
    ftplib
    smtplib
    requests
    httpx
    urllib3
    aiohttp
; ADR-012's architecture is a chain, not a wall: `farsight.acquire` is the one package permitted
; a networking library, and the CLI's fetch module is its only importer. So `farsight.cli` does
; reach the network -- through exactly one edge, and only that one. Naming the edge here is what
; keeps the rest of `farsight.cli` guarded: any OTHER route from the CLI to a socket still fails,
; which is what a bare removal of `farsight.cli` from the source list would have given up.
ignore_imports =
    farsight.cli.fetch -> farsight.acquire.fetch

[importlinter:contract:geometry_is_not_an_engine]
; ADR-018 Enforcement 4, "first green by week 3". `spiceypy` may be imported nowhere under
; src/farsight/ except `farsight.engines.spice.**`.
;
; This is the mechanical prevention of ADR-018's rejected Option 2 -- the link-chain adapter
; furnishing kernels and calling SPICE itself -- which the record calls "the architecture that
; happens by default under schedule pressure in week 3". The contract exists so that is blocked
; by a check rather than by somebody remembering the record.
;
; It also protects ADR-015 decision 7, which is the sharper reason: the SPICE time path and the
; independent astropy time path are cross-checked, never collapsed into one call. If any module
; outside engines.spice could reach spiceypy, that independence could become false at the bit
; level with every test still green.
;
; Guarding all of `farsight` and exempting the one package -- rather than enumerating the other
; twelve -- means a new engine package added later is guarded by default instead of being
; unlisted and therefore free.
name = spiceypy lives only in the spice adapter
type = forbidden
source_modules =
    farsight
forbidden_modules =
    spiceypy
ignore_imports =
    farsight.engines.spice -> spiceypy
    farsight.engines.spice.* -> spiceypy
; The exemption is declared before the adapter exists, which is the whole point: ADR-018 dates
; this contract to week 3 so the rule is in place before the code it constrains. import-linter
; treats an ignore that matches nothing as an error by default -- a good rule against stale
; ignores, and the wrong one for an exemption written in advance -- so it warns here instead.
; When engines/spice lands the warning disappears; if it ever reappears, the adapter stopped
; importing spiceypy and the exemption is stale.
unmatched_ignore_imports_alerting = warn
